# Server Configuration
PORT=3000

# AI / Gemini Configuration
AI_API_KEY=your_google_gemini_api_key_here
GENAI_MODEL=gemini-2.5-flash
GENAI_API_VERSION=v1beta

# Supabase Configuration (Dev/Demo Context Source)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Meta / Instagram Configuration
PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
VERIFY_TOKEN=your_custom_webhook_verification_token_here
INSTAGRAM_ACCOUNT_ID=17841403795491164

# Default Merchant Configuration
DEFAULT_MERCHANT_SCOPED_ID=default

# Topic 1 StoreBuilder Integration (Optional)
# When set, bot will fetch live catalogue from Topic 1 StoreBuilder API
# Leave empty/unset to use Supabase fallback (demo mode)
STOREFRONT_API_BASE_URL=
STOREFRONT_API_KEY=
STOREFRONT_CX_CONTEXT_PATH=/merchants/{merchantId}/cx-context
STOREFRONT_ORDERS_PATH=/merchants/{merchantId}/orders
STOREFRONT_API_TIMEOUT_MS=12000

# Optional: Meta Graph API Version
META_GRAPH_VERSION=v20.0
